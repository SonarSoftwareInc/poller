{
    "name": "sonarsoftwareinc/poller",
    "description": "A poller for Sonar",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "amphp/amp": "^2.6.4",
        "amphp/parallel": "^1.4.3",
        "ext-sockets": "*",
        "ext-json": "*",
        "ext-gmp": "*",
        "ext-sqlite3": "*",
        "ext-zlib": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9.2",
        "psy/psysh": "@stable",
        "league/booboo": "^2.1",
        "amphp/socket": "^1.2.1",
        "league/climate": "^3.10",
        "leth/ip-address": "^1.1.2",
        "phpseclib/phpseclib": "^2.0.48",
        "pear2/net_routeros": "dev-develop@dev",
        "pear2/net_transmitter": "^1.0.0@dev",
        "monolog/monolog": "^2.10",
        "nesbot/carbon": "^2.73",
        "jawira/case-converter": "^3.5.2",
        "sonarsoftwareinc/external_tool_template": "^1.0",
        "twig/twig": "^3.20",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "blackfire/php-sdk": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Poller\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Sonar Software",
            "email": "support@sonar.software"
        }
    ],
    "scripts": {
        "post-install-cmd":[
            "cp -R vendor/sonarsoftwareinc/external_tool_template/assets www/",
            "touch permanent_config/database"
        ]
    },
    "minimum-stability": "stable"
}
